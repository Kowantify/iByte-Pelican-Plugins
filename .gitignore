# One repository: iByte Pelican Plugins (the five plugin folders are the repo content)

# Everything outside the five plugin folders is local tooling/session state
/*
!/.gitignore
!/README.md
!/iByte-PrometheusExporter/
!/iByte-PrometheusExporterAddon-Restic/
!/iByte-Restic/
!/iByte-MinecraftManager/
!/iByte-EggChanger/

# OS/editor noise
Thumbs.db
.DS_Store

# AI/agent working files (never published)
**/AGENTS.md
**/CLAUDE.md
**/GEMINI.md
**/AGENTS.local.md
**/FIRST_MESSAGE.md
**/.claude/
**/.cursor/
**/.codex/
**/.aider*
**/.windsurfrules
**/.clinerules
**/copilot-instructions.md

# Per-plugin junk that must not ship even if re-created locally
**/.tools/
**/.build/
**/.research/
**/.upstream/
**/.acceptance/
**/.validation/
**/vendor/
**/node_modules/

# Local env + logs
**/.env
**/.env.*
**/*.log

# Local ops/session probe scripts (never published)
iByte-EggChanger/tests/deploy-*.sh
iByte-EggChanger/tests/final-*.sh
iByte-EggChanger/tests/verify-*.sh
iByte-EggChanger/tests/check-*.sh
iByte-EggChanger/tests/dump-*.sh
iByte-EggChanger/tests/find-*.sh
iByte-EggChanger/tests/restic-tables.sh
iByte-EggChanger/tests/recent-errors.sh
iByte-EggChanger/tests/check-paymenter-block.sh
iByte-EggChanger/tests/deploy-restic-api-retention.sh