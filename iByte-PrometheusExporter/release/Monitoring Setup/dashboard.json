{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Choose your Prometheus data source",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": ""
    },
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "12.0.2"
    }
  ],
  "id": null,
  "uid": "ibyte-pelican-resources",
  "title": "Pelican servers",
  "description": "CPU, memory, disk, network and backup metrics for every Pelican node and game server. Names and owners are joined from info metrics at query time. Gaps are missing data, not zeros. Disk freshness depends on the Wings cache.",
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 3,
  "refresh": "5s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "tags": [
    "pelican",
    "ibyte"
  ],
  "templating": {
    "list": [
      {
        "name": "node",
        "type": "query",
        "label": "Node",
        "datasource": "${DS_PROMETHEUS}",
        "definition": "label_values(ibyte_pelican_node_collection_success,node_id)",
        "query": {
          "query": "label_values(ibyte_pelican_node_collection_success,node_id)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {}
      },
      {
        "name": "server",
        "type": "query",
        "label": "Server UUID",
        "datasource": "${DS_PROMETHEUS}",
        "definition": "label_values(ibyte_pelican_server_state{node_id=~\"$node\"},server_uuid)",
        "query": {
          "query": "label_values(ibyte_pelican_server_state{node_id=~\"$node\"},server_uuid)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Fleet overview",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Users",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "refId": "A",
          "expr": "ibyte_prometheus_panel_users",
          "instant": true,
          "legendFormat": "Users"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "decimals": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 2
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Root admins",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "refId": "A",
          "expr": "ibyte_prometheus_panel_root_admins",
          "instant": true,
          "legendFormat": "Root admins"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "decimals": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 2
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Nodes",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "refId": "A",
          "expr": "ibyte_prometheus_panel_nodes",
          "instant": true,
          "legendFormat": "Nodes"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "decimals": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 2
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Nodes in maintenance",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "refId": "A",
          "expr": "ibyte_prometheus_panel_nodes_maintenance",
          "instant": true,
          "legendFormat": "Nodes in maintenance"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              [
                0,
                "green"
              ],
              [
                1,
                "orange"
              ]
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 2
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Servers (total)",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "refId": "A",
          "expr": "ibyte_prometheus_panel_servers",
          "instant": true,
          "legendFormat": "Servers (total)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "decimals": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 6
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Servers suspended",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "refId": "A",
          "expr": "ibyte_prometheus_panel_servers_status{status=\"suspended\"}",
          "instant": true,
          "legendFormat": "Servers suspended"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              [
                0,
                "green"
              ],
              [
                1,
                "orange"
              ]
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 6
      }
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Servers installing",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "refId": "A",
          "expr": "ibyte_prometheus_panel_servers_status{status=\"installing\"}",
          "instant": true,
          "legendFormat": "Servers installing"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              [
                0,
                "green"
              ],
              [
                1,
                "#eab839"
              ]
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 6
      }
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Eggs",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "refId": "A",
          "expr": "ibyte_prometheus_panel_eggs",
          "instant": true,
          "legendFormat": "Eggs"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "decimals": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 6
      }
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Nodes reachable (of $node)",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(ibyte_prometheus_node_collection_success{node_id=~\"$node\"})",
          "instant": true,
          "legendFormat": "Nodes reachable (of $node)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "decimals": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 10
      }
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Worst node age (s)",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "refId": "A",
          "expr": "max(ibyte_prometheus_node_collection_age_seconds{node_id=~\"$node\"})",
          "instant": true,
          "legendFormat": "Worst node age (s)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              [
                0,
                "green"
              ],
              [
                15,
                "green"
              ],
              [
                20,
                "orange"
              ],
              [
                30,
                "red"
              ]
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 10
      }
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Node consecutive failures (max)",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "refId": "A",
          "expr": "max(ibyte_prometheus_node_consecutive_failures{node_id=~\"$node\"})",
          "instant": true,
          "legendFormat": "Node consecutive failures (max)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              [
                0,
                "green"
              ],
              [
                1,
                "orange"
              ],
              [
                3,
                "red"
              ]
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 10
      }
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Servers offline (of $node)",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(ibyte_prometheus_server_state{node_id=~\"$node\",server_uuid=~\"$server\",state=\"offline\"})",
          "instant": true,
          "legendFormat": "Servers offline (of $node)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              [
                0,
                "green"
              ],
              [
                1,
                "#eab839"
              ]
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 10
      }
    },
    {
      "id": 14,
      "type": "stat",
      "title": "Node memory allocated / capacity",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (node_id) (ibyte_prometheus_server_memory_limit_bytes{node_id=~\"$node\",server_uuid=~\"$server\"}) / on (node_id) group_left (node_name) ibyte_prometheus_node_memory_capacity_bytes{node_id=~\"$node\"}",
          "instant": true,
          "legendFormat": "{{node_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              [
                0,
                "green"
              ],
              [
                70,
                "#eab839"
              ],
              [
                85,
                "orange"
              ],
              [
                100,
                "red"
              ]
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 14
      }
    },
    {
      "id": 15,
      "type": "stat",
      "title": "Node disk allocated / capacity",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (node_id) (ibyte_prometheus_server_disk_limit_bytes{node_id=~\"$node\",server_uuid=~\"$server\"}) / on (node_id) group_left (node_name) ibyte_prometheus_node_disk_capacity_bytes{node_id=~\"$node\"}",
          "instant": true,
          "legendFormat": "{{node_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              [
                0,
                "green"
              ],
              [
                70,
                "#eab839"
              ],
              [
                85,
                "orange"
              ],
              [
                100,
                "red"
              ]
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 14
      }
    },
    {
      "id": 16,
      "type": "stat",
      "title": "Node CPU allocated / capacity",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (node_id) (ibyte_prometheus_server_cpu_limit_cores{node_id=~\"$node\",server_uuid=~\"$server\"}) / on (node_id) group_left (node_name) ibyte_prometheus_node_cpu_capacity_cores{node_id=~\"$node\"}",
          "instant": true,
          "legendFormat": "{{node_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              [
                0,
                "green"
              ],
              [
                70,
                "#eab839"
              ],
              [
                85,
                "orange"
              ],
              [
                100,
                "red"
              ]
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 14
      }
    },
    {
      "id": 17,
      "type": "row",
      "title": "Node leaders",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 18
      }
    },
    {
      "id": 18,
      "type": "barchart",
      "title": "Top 5 nodes by live CPU",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "refId": "A",
          "expr": "(topk(5, avg by (node_id) (ibyte_prometheus_server_cpu_usage_ratio{node_id=~\"$node\",server_uuid=~\"$server\"}))) * on (node_id) group_left (node_name) ibyte_pelican_node_info{node_id=~\"$node\"}",
          "instant": true,
          "legendFormat": "Node {{node_name}}"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "showValue": "always"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "_x": 0
    },
    {
      "id": 19,
      "type": "barchart",
      "title": "Top 5 nodes by live memory",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "refId": "A",
          "expr": "(topk(5, sum by (node_id) (ibyte_prometheus_server_memory_usage_bytes{node_id=~\"$node\",server_uuid=~\"$server\"}))) * on (node_id) group_left (node_name) ibyte_pelican_node_info{node_id=~\"$node\"}",
          "instant": true,
          "legendFormat": "Node {{node_name}}"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "showValue": "always"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "_x": 12
    },
    {
      "id": 20,
      "type": "barchart",
      "title": "Memory: live use vs allocated, per node",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "refId": "A",
          "expr": "(sum by (node_id) (ibyte_prometheus_server_memory_usage_bytes{node_id=~\"$node\",server_uuid=~\"$server\"}) / sum by (node_id) (ibyte_prometheus_server_memory_limit_bytes{node_id=~\"$node\",server_uuid=~\"$server\"})) * on (node_id) group_left (node_name) ibyte_pelican_node_info{node_id=~\"$node\"}",
          "instant": true,
          "legendFormat": "Node {{node_name}}"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "showValue": "always"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "_x": 0
    },
    {
      "id": 21,
      "type": "barchart",
      "title": "Disk: live use vs allocated, per node",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "refId": "A",
          "expr": "(sum by (node_id) (ibyte_prometheus_server_disk_usage_bytes{node_id=~\"$node\",server_uuid=~\"$server\"}) / sum by (node_id) (ibyte_prometheus_server_disk_limit_bytes{node_id=~\"$node\",server_uuid=~\"$server\"})) * on (node_id) group_left (node_name) ibyte_pelican_node_info{node_id=~\"$node\"}",
          "instant": true,
          "legendFormat": "Node {{node_name}}"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "showValue": "always"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 28
      },
      "_x": 12
    },
    {
      "id": 22,
      "type": "barchart",
      "title": "Allocations in use / total, per node",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "refId": "A",
          "expr": "(ibyte_prometheus_node_allocations_used{node_id=~\"$node\"} / ibyte_prometheus_node_allocations{node_id=~\"$node\"}) * on (node_id) group_left (node_name) ibyte_pelican_node_info{node_id=~\"$node\"}",
          "instant": true,
          "legendFormat": "Node {{node_name}}"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "showValue": "always"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 36
      },
      "_x": 0
    },
    {
      "id": 23,
      "type": "barchart",
      "title": "Backups bytes per node",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "refId": "A",
          "expr": "(ibyte_prometheus_node_backups_bytes{node_id=~\"$node\"}) * on (node_id) group_left (node_name) ibyte_pelican_node_info{node_id=~\"$node\"}",
          "instant": true,
          "legendFormat": "Node {{node_name}}"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "showValue": "always"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 36
      },
      "_x": 12
    },
    {
      "id": 24,
      "type": "row",
      "title": "Server drilldown (pick Node and Server above)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 44
      }
    },
    {
      "id": 25,
      "type": "table",
      "title": "All servers: CPU / memory / disk / headroom / uptime",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "refId": "A",
          "expr": "(ibyte_prometheus_server_cpu_usage_ratio{node_id=~\"$node\",server_uuid=~\"$server\"}) * on (server_uuid) group_left (name, owner) ibyte_pelican_server_info{node_id=~\"$node\"}",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "expr": "(ibyte_prometheus_server_memory_usage_bytes{node_id=~\"$node\",server_uuid=~\"$server\"}) * on (server_uuid) group_left (name, owner) ibyte_pelican_server_info{node_id=~\"$node\"}",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "C",
          "expr": "(ibyte_prometheus_server_memory_limit_bytes{node_id=~\"$node\",server_uuid=~\"$server\"}) * on (server_uuid) group_left (name, owner) ibyte_pelican_server_info{node_id=~\"$node\"}",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "D",
          "expr": "(ibyte_prometheus_server_memory_limit_bytes{node_id=~\"$node\",server_uuid=~\"$server\"} / ibyte_prometheus_server_memory_usage_bytes{node_id=~\"$node\",server_uuid=~\"$server\"}) * on (server_uuid) group_left (name, owner) ibyte_pelican_server_info{node_id=~\"$node\"}",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "E",
